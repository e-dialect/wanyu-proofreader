# Shared environment for the local and Traefik production Compose files.
# Copy this file to .env, then use one of these entry points:
#   docker compose up -d --build
#   docker compose -f docker-compose.traefik.yml up -d --build

# Host port used only by the default local production Compose file.
FRONTEND_PORT=8080

# Required before the first production startup: Fangji business admin user.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-please
APP_ADMIN_NAME=管理员

# Optional: PocketBase Admin UI account. This is separate from the Fangji
# business admin above. Open the enabled administrator UI at https://your-host/_/.
PB_ADMIN_EMAIL=pb-admin@example.com
PB_ADMIN_PASSWORD=change-me-please-too

# The UI still requires PocketBase administrator authentication. Explicit false
# disables both /_ and /_/. Recreate frontend after changing this setting.
# Development mode is directly available at http://localhost:8090/_/.
# Optional override: Traefik defaults to true; local production defaults to false.
# ENABLE_POCKETBASE_ADMIN_UI=false

# Comma-separated CIDRs for trusted reverse-proxy/container networks. Only
# peers in these ranges may supply the original client address. Use the
# narrowest network CIDR available in production.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Usually keep empty for same-origin deployments:
#   http://localhost:8080/      -> frontend
#   http://localhost:8080/api/  -> PocketBase API
#   http://localhost:8080/_/    -> 404 unless explicitly enabled above
# Set only when the browser should talk to a different PocketBase origin.
BACKEND_URL=

# Optional CORS allow list for cross-origin deployments.
# Example: PB_ALLOWED_ORIGINS=https://fangji.example.com
PB_ALLOWED_ORIGINS=

# Optional: enable “兴化语记” external sign-in. Supply the HTTPS service base
# URL only; Fangji appends /login and never stores or forwards the remote token.
HINGHWA_IDENTITY_BASE_URL=

# Used only by docker-compose.traefik.yml. TRAEFIK_HOST is intentionally
# commented out so a Traefik deployment cannot silently use an example domain.
TRAEFIK_NETWORK=traefik-global-proxy
# TRAEFIK_HOST=fangji.example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional local OCR worker, enabled only with docker-compose.ocr.yml. No external
# recognition APIs are supported. Generate the token in operator-owned .env.
OCR_ENGINE_ENABLED=false
# OCR_WORKER_TOKEN=<at least 32 random characters, never commit the real value>
